<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: hiển thị thông báo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hiện màn hình cuộc gọi khi máy đang khoá. Android 14+: Google Play chỉ tự cấp cho app gọi điện/báo thức. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.tingpush.sdk.TingPushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name="com.tingpush.sdk.IncomingCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity="com.tingpush.sdk.call"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:turnScreenOn="true" />

        <receiver
            android:name="com.tingpush.sdk.CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
