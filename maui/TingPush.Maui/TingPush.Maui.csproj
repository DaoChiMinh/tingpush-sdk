<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TingPushSdk</RootNamespace>
    <AssemblyName>TingPush.Maui</AssemblyName>

    <PackageId>TingPush.Maui</PackageId>
    <Version>1.0.0</Version>
    <Description>.NET MAUI SDK for TingPush push notifications and incoming calls (CallKit on iOS, full-screen call UI on Android).</Description>
    <Authors>TingPush</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tingpush/tingpush-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tingpush/tingpush-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>push;notifications;fcm;apns;callkit;voip;maui;tingpush</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <!-- Firebase kéo AndroidX mới hơn bộ của MAUI: nâng các gói Ktx đi kèm cho khớp (tránh lệch phiên bản lúc chạy). -->
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
  </ItemGroup>

</Project>
